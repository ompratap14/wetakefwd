# Set these privately in your hosting environment; never commit real secrets.
SECRET_KEY=
FLASK_ENV=production
# HTTPS email API works on Render Free; Gmail SMTP is blocked there.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
# Optional for hosts that allow SMTP:
GMAIL_APP_PASSWORD=
# Admin routes stay disabled until both values are configured.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# On Render, point this at an attached persistent disk (paid service required).
# DATABASE_PATH=/var/data/database.db
